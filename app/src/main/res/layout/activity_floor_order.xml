<?xml version="1.0" encoding="utf-8"?>
<!--
    FloorOrderActivity layout.
    Three panels, only one visible at a time:
      panel_method_choice  — Lightning / Cash / Card choice
      panel_lightning      — QR display + countdown
      panel_success        — confirmed / recorded confirmation
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/refueler_bg">

    <!-- ============================================================ -->
    <!-- Panel 1 — Payment method choice                              -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/panel_method_choice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/floor_order_total_label"
            android:textColor="@color/refueler_fg_muted"
            android:textSize="14sp"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/refueler_fg"
            android:textSize="52sp"
            android:textStyle="bold"
            android:layout_marginBottom="48dp" />

        <!-- Lightning -->
        <Button
            android:id="@+id/btn_pay_lightning"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/floor_order_pay_lightning"
            android:backgroundTint="@color/refueler_gold"
            android:textColor="@color/refueler_bg"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Cash -->
        <Button
            android:id="@+id/btn_pay_cash"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/floor_order_pay_cash"
            android:backgroundTint="@color/refueler_surface_raised"
            android:textColor="@color/refueler_fg"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Card -->
        <Button
            android:id="@+id/btn_pay_card"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/floor_order_pay_card"
            android:backgroundTint="@color/refueler_surface_raised"
            android:textColor="@color/refueler_fg"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- ============================================================ -->
    <!-- Panel 2 — Lightning QR display                               -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/panel_lightning"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_lightning_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/refueler_fg"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/progress_lightning"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/refueler_gold"
            android:visibility="visible"
            android:layout_marginBottom="24dp" />

        <!-- QR code — Paper bg on Carbon screen for maximum contrast -->
        <ImageView
            android:id="@+id/iv_qr"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:background="@color/refueler_fg"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Lightning invoice QR code"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/refueler_fg_muted"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_cancel_lightning"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@android:string/cancel"
            android:backgroundTint="@color/refueler_surface"
            android:textColor="@color/refueler_fg_muted"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ============================================================ -->
    <!-- Panel 3 — Success / confirmed                                -->
    <!-- ============================================================ -->
    <LinearLayout
        android:id="@+id/panel_success"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_success_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/refueler_status_ready"
            android:textSize="20sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="40dp" />

        <Button
            android:id="@+id/btn_done"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@android:string/ok"
            android:backgroundTint="@color/refueler_surface_raised"
            android:textColor="@color/refueler_fg"
            android:textSize="16sp" />

    </LinearLayout>

</FrameLayout>
