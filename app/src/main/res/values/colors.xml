<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Refueler Carbon — canonical design system                      -->
    <!-- Replaces Numo palette (numo_navy, numo_fluorescent_green, etc) -->
    <!-- NumoPay-B · 2026-08-19                                         -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <!-- Raw brand constants -->
    <color name="refueler_carbon">#FF1A1A1A</color>
    <color name="refueler_paper">#FFE8E2D8</color>

    <!-- Background / foreground -->
    <color name="refueler_bg">#FF1A1A1A</color>
    <color name="refueler_fg">#FFE8E2D8</color>
    <color name="refueler_fg_muted">#FFB0AAA2</color>
    <color name="refueler_fg_subtle">#FF6A6560</color>

    <!-- Surfaces -->
    <color name="refueler_surface">#FF242424</color>
    <color name="refueler_surface_raised">#FF2E2E2E</color>

    <!-- Accent — gold, restricted to chrome dividers and auth buttons -->
    <color name="refueler_gold">#FFC8A96E</color>

    <!-- Status / semantic -->
    <color name="refueler_success">#FF27AE60</color>
    <color name="refueler_danger">#FFE05252</color>

    <!-- Order status — protected, never reassigned -->
    <color name="refueler_status_pending">#FFC8A96E</color>  <!-- gold -->
    <color name="refueler_status_in_prep">#FF7899D4</color>  <!-- periwinkle -->
    <color name="refueler_status_ready">#FF3DCA7A</color>    <!-- green -->

    <!-- Overlay / scrim — Carbon-appropriate -->
    <color name="refueler_scrim">#99000000</color>
    <color name="refueler_ripple_on_dark">#33E8E2D8</color>
    <color name="refueler_stroke_on_dark">#26E8E2D8</color>

    <!-- Keypad / input — used by PinDotsView, PinKeypadView -->
    <color name="refueler_keypad_bg">@color/refueler_surface</color>
    <color name="refueler_keypad_pressed">@color/refueler_surface_raised</color>
    <color name="refueler_keypad_text">@color/refueler_fg</color>
    <color name="refueler_input_border">#26E8E2D8</color>

    <!-- Scanner background (QRScannerActivity) -->
    <color name="refueler_scanner_bg">#FF000000</color>

    <!-- Legacy aliases for views still referencing old names.         -->
    <!-- Remove progressively as layouts are updated in NumoPay-C.     -->
    <color name="colorPrimary">@color/refueler_gold</color>
    <color name="colorPrimaryVariant">@color/refueler_surface_raised</color>
    <color name="colorOnPrimary">@color/refueler_bg</color>
    <color name="colorSecondary">@color/refueler_gold</color>
    <color name="colorSecondaryVariant">@color/refueler_surface</color>
    <color name="colorOnSecondary">@color/refueler_bg</color>
    <color name="colorSurface">@color/refueler_surface</color>
    <color name="colorOnSurface">@color/refueler_fg</color>
    <color name="windowBackground">@color/refueler_bg</color>
    <color name="surfaceColor">@color/refueler_surface</color>

    <!-- Primitives kept for system use -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Refueler warn color -->
    <color name="refueler_warn">#FFC8943A</color>

    <!-- Legacy Numo color aliases — map to Refueler tokens -->
    <color name="color_warning_red">@color/refueler_danger</color>
    <color name="color_warning">@color/refueler_warn</color>
    <color name="color_success_green">@color/refueler_success</color>
    <color name="color_bitcoin_orange">@color/refueler_gold</color>
    <color name="color_error">@color/refueler_danger</color>
    <color name="color_bg_white">@color/refueler_fg</color>
    <color name="color_primary_green">@color/refueler_bg</color>
    <color name="empty_state_background">@color/refueler_bg</color>

<color name="numo_red">#FFE05252</color>
<color name="numo_bitcoin_orange">#FFC8A96E</color>
<color name="numo_green">#FF27AE60</color>
<color name="numo_dark">#FF1A1A1A</color>
<color name="color_primary_purple">#FFC8A96E</color>

    <!-- Legacy Numo alias — maps to Refueler gold, satisfies remaining drawable/layout refs -->
    <color name="color_primary">#FFC8A96E</color>
    <color name="color_primary_variant">#FFC8A96E</color>
    <color name="color_primary_purple">#FFC8A96E</color>
</resources>
