<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Theme.Refueler — Refueler Carbon, always-on.
        Replaces Theme.Numo. No night/light toggle; no AppCompatDelegate calls.
        NumoPay-B · 2026-08-19
    -->

    <style name="Theme.Refueler" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/refueler_gold</item>
        <item name="colorPrimaryVariant">@color/refueler_surface_raised</item>
        <item name="colorOnPrimary">@color/refueler_bg</item>
        <item name="colorSecondary">@color/refueler_gold</item>
        <item name="colorSecondaryVariant">@color/refueler_surface</item>
        <item name="colorOnSecondary">@color/refueler_bg</item>
        <item name="android:statusBarColor">@color/refueler_bg</item>
        <item name="android:navigationBarColor">@color/refueler_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/refueler_bg</item>
        <item name="android:colorBackground">@color/refueler_bg</item>
        <item name="colorSurface">@color/refueler_surface</item>
        <item name="colorOnSurface">@color/refueler_fg</item>
        <item name="android:textColor">@color/refueler_fg</item>
        <item name="colorControlNormal">@color/refueler_fg_muted</item>
        <item name="colorControlActivated">@color/refueler_success</item>
        <item name="popupMenuStyle">@style/Widget.Refueler.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Refueler.PopupMenu</item>
        <item name="snackbarStyle">@style/Widget.Refueler.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.Refueler.Snackbar.Text</item>
    </style>

    <style name="Theme.Refueler.Splash" parent="Theme.Refueler">
        <item name="android:windowBackground">@color/refueler_bg</item>
        <item name="android:statusBarColor">@color/refueler_bg</item>
        <item name="android:navigationBarColor">@color/refueler_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Refueler.Fullscreen" parent="Theme.Refueler">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@color/refueler_scanner_bg</item>
        <item name="android:navigationBarColor">@color/refueler_scanner_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Refueler.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Theme.Refueler.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="bottomSheetStyle">@style/Widget.Refueler.BottomSheet</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>

    <style name="Widget.Refueler.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/refueler_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Refueler.BottomSheet</item>
        <item name="behavior_peekHeight">auto</item>
        <item name="behavior_fitToContents">true</item>
        <item name="android:elevation">16dp</item>
    </style>

    <style name="ShapeAppearance.Refueler.BottomSheet" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Refueler.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:popupElevation">0dp</item>
    </style>

    <style name="Widget.Refueler.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="android:background">@color/refueler_surface_raised</item>
    </style>

    <style name="Widget.Refueler.Snackbar.Text" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/refueler_fg</item>
    </style>

    <style name="Widget.Refueler.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/refueler_bg</item>
        <item name="backgroundTint">@color/refueler_gold</item>
    </style>

    <!-- Legacy aliases — one of each, no duplicates -->
    <style name="Theme.Numo" parent="Theme.Refueler" />
    <style name="Theme.Numo.Fullscreen" parent="Theme.Refueler.Fullscreen" />
    <style name="Theme.Numo.BottomSheet" parent="Theme.Refueler.BottomSheet" />
    <style name="Theme.Numo.Splash" parent="Theme.Refueler.Splash" />
    <style name="Theme_Numo" parent="Theme.Refueler" />
    <style name="Theme_Numo_Dialog" parent="Theme.Refueler.Dialog" />
    <style name="Theme_Numo_BottomSheet" parent="Theme.Refueler.BottomSheet" />
    <style name="Widget.Numo.BottomSheet" parent="Widget.MaterialComponents.BottomSheet" />

</resources>
